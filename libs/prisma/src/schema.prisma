datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../client"
}

generator json {
  provider = "prisma-json-types-generator"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./schema"
  config   = "./generator/zod-generator.config.json"
}

enum UserRole {
  Admin   @map("ADMIN")
  Manager @map("MANAGER")
  User    @map("USER")

  @@map("user_role")
}

enum AuthProviderType {
  Google @map("GOOGLE")

  @@map("auth_provider_type")
}

model AuthProvider {
  externalId String
  userId     Int              @map("user_id")
  provider   AuthProviderType
  user       User             @relation("user_to_auth_providers", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, provider])
  @@map("auth_providers")
}

/// @zod.import(["import { aliases as aliasesForUser } from 'platform/zod'"])
model User {
  /// @zod.custom.use(aliasesForUser.numberId)
  id            Int            @id @default(autoincrement())
  /// @zod.custom.use(aliasesForUser.email)
  email         String         @unique
  fullName      String?        @map("full_name")
  accessToken   String?        @map("access_token")
  refreshToken  String?        @map("refresh_token")
  role          UserRole       @default(User)
  manager       Manager?       @relation("user_to_manager")
  patient       Patient?       @relation("user_to_patient")
  authProviders AuthProvider[] @relation("user_to_auth_providers")

  @@map("users")
}

model Manager {
  userId  Int      @id @map("user_id")
  user    User     @relation("user_to_manager", fields: [userId], references: [id], onDelete: Cascade)
  clinics Clinic[] @relation("manager_to_clinic")

  @@map("managers")
}

model Clinic {
  id        Int     @id @default(autoincrement())
  managerId Int     @map("manager_id")
  name      String
  manager   Manager @relation("manager_to_clinic", fields: [managerId], references: [userId], onDelete: Cascade)

  patients  Patient[]      @relation("clinic_to_patients")
  templates Template[]     @relation("clinic_to_templates")
  reports   ClinicReport[] @relation("clinic_to_reports")

  @@map("clinics")
}

model Patient {
  userId   Int            @id @map("user_id")
  clinicId Int            @map("clinic_id")
  user     User           @relation("user_to_patient", fields: [userId], references: [id], onDelete: Cascade)
  clinic   Clinic         @relation("clinic_to_patients", fields: [clinicId], references: [id], onDelete: Cascade)
  reports  ClinicReport[] @relation("patient_to_reports")

  @@map("patients")
}

/// @zod.import(["import { TemplateDataSchema } from 'platform/prisma/data'"])
model Template {
  id             Int             @id @default(autoincrement())
  clinicId       Int             @map("clinic_id")
  name           String
  /// @zod.custom.use(TemplateDataSchema)
  /// [TemplateData]
  data           Json
  clinic         Clinic          @relation("clinic_to_templates", fields: [clinicId], references: [id], onDelete: Cascade)
  patientReports PatientReport[] @relation("template_to_patient_reports")

  @@map("templates")
}

/// @zod.import(["import { ReportDataSchema } from 'platform/prisma/data'"])
model ClinicReport {
  id            Int            @id @default(autoincrement())
  patientId     Int            @map("patient_id")
  clinicId      Int            @map("clinic_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  /// @zod.custom.use(ReportDataSchema)
  /// [ReportData]
  data          Json
  patient       Patient        @relation("patient_to_reports", fields: [patientId], references: [userId], onDelete: Cascade)
  clinic        Clinic         @relation("clinic_to_reports", fields: [clinicId], references: [id], onDelete: Cascade)
  patientReport PatientReport? @relation("report_to_patient_report")

  @@map("clinic_reports")
}

model PatientReport {
  reportId   Int          @id @map("report_id")
  templateId Int          @map("template_id")
  report     ClinicReport @relation("report_to_patient_report", fields: [reportId], references: [id], onDelete: Cascade)
  template   Template     @relation("template_to_patient_reports", fields: [templateId], references: [id], onDelete: Cascade)

  @@map("patient_reports")
}
