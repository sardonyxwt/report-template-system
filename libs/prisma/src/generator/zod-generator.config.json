{
  "mode": "custom",
  "useMultipleFiles": false,
  "singleFileName": "index.ts",
  "pureModels": true,
  "dateTimeStrategy": "coerce",
  "optionalFieldBehavior": "nullish",
  "variants": {
    "pure": { "enabled": true },
    "input": { "enabled": false },
    "result": { "enabled": false }
  },
  "emit": {
    "objects": false,
    "crud": false,
    "variants": false
  },
  "naming": {
    "preset": "zod-prisma-types",
    "pureModel": {
      "exportNamePattern": "{Model}Schema",
      "legacyAliases": false
    }
  },
  "safety": {
    "skipManifest": true
  }
}
