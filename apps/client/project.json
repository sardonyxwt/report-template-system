{
  "name": "platform/client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/client/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": ["platform/common-base", "platform/prisma", "platform/zod"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{workspaceRoot}/dist/apps/client"],
      "options": {
        "outputPath": "dist/apps/client",
        "configFile": "apps/client/vite.config.ts",
        "tsConfig": "apps/client/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "platform/client:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "fix": true,
        "lintFilePatterns": ["apps/client/**/*.{ts,tsx}"]
      }
    }
  }
}
